{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VibeSpace Master Native Acceptance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "runtime",
    "limits",
    "scenarios",
    "priorEvidence",
    "excludedClaims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "sourceManifestHash",
        "nativeBinaryHash"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "not": {
            "const": "observed"
          }
        },
        "sourceManifestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "not": {
            "const": "observed"
          }
        },
        "nativeBinaryHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "not": {
            "const": "observed"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "mainTarget",
        "appPid",
        "webviewPid"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "not": {
            "const": "observed"
          }
        },
        "mainTarget": {
          "const": "main"
        },
        "appPid": {
          "type": "integer",
          "minimum": 1
        },
        "webviewPid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realChatSubmissions",
        "parallelUiControllers",
        "providerTurnDeadlineMs"
      ],
      "properties": {
        "realChatSubmissions": {
          "const": 2
        },
        "parallelUiControllers": {
          "const": 1
        },
        "providerTurnDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceDependencies",
          "fixtureHash",
          "expectedResult",
          "deadlineMs",
          "allowedEffects",
          "providerCostClassification",
          "evidenceRequirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
          },
          "sourceDependencies": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "fixtureHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedResult": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "deadlineMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "allowedEffects": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "providerCostClassification": {
            "enum": [
              "none",
              "local-fixture",
              "one-real-turn"
            ]
          },
          "evidenceRequirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "priorEvidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "excludedClaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "all-provider interoperability"
          }
        },
        {
          "contains": {
            "const": "statistical reliability"
          }
        },
        {
          "contains": {
            "const": "unmeasured savings"
          }
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
