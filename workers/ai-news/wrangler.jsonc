{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibespace-ai-news",
  "main": "src/free.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "*",
    "MAX_ITEMS_PER_RUN": "30",
    "RETENTION_DAYS": "45"
  }
}
