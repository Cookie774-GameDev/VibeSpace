# VibeSpace - Environment variables (example)
#
# Copy this file to .env.local (in app/ directory) and fill in your real values.
# .env.local is gitignored and will never be committed.
#
# All Vite client-exposed vars must be prefixed VITE_

# --- VibeSpace Cloud backend (maintainer/release builds) ---
# Official VibeSpace installers include the app backend config at build time.
# Copy to app/.env.local and fill in your Supabase publishable key.
# Replace <your-project-ref> with your Supabase project ref (Dashboard → Settings → General).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- AI Providers (BYOK) ---
# Optional - users can also enter these in the Settings UI
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GOOGLE_API_KEY=

# --- Stripe checkout ---
# Live checkout is created server-side by Supabase Edge Functions.
# Do not configure static buy.stripe.com links in the desktop app.

# --- Jarvis Call / phone-jarvis bridge ---
# Public HTTPS origin for the deployed phone-jarvis cloud service.
# Example: https://phone-jarvis.example.com
VITE_PHONE_JARVIS_CLOUD_URL=
VITE_VIBESPACE_MCP_URL=

# --- Admin entitlement builds ---
# Use one of these for local owner/admin builds. Admin users resolve to
# Ultra access and can use Jarvis Call even before Stripe subscription
# sync is configured. Do not use this as a server-side auth boundary.
VITE_JARVIS_ADMIN=false
VITE_JARVIS_LOCAL_ADMIN=false
VITE_JARVIS_ADMIN_EMAILS=
VITE_JARVIS_ADMIN_LOCAL_IDS=

# --- Telemetry ---
# Opt-in usage analytics (PostHog). Leave blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# --- Feature flags ---
VITE_ENABLE_VOICE=true
VITE_ENABLE_COUNCIL=true
VITE_ENABLE_CLOUD_SYNC=true

# --- Build ---
VITE_APP_VERSION=1.5.0
# Public P-256 verification keys for bounded signed offline Access leases.
# JSON array entries: {"kid":"<key-id>","jwk":{"kty":"EC","crv":"P-256","x":"<base64url-x>","y":"<base64url-y>","key_ops":["verify"],"ext":true}}
# Keep [] to disable offline lease use fail-closed; never place a private JWK ("d") here.
VITE_ACCESS_LEASE_PUBLIC_KEYS=[]

# Official Codex Command Center Windows release shown in Tools. These values
# are public release authority, not secrets. All three are required; VibeSpace
# fails closed when the URL, version, or pinned SHA-256 is missing/invalid.
VITE_CODEX_COMMAND_CENTER_DOWNLOAD_URL=
VITE_CODEX_COMMAND_CENTER_DOWNLOAD_SHA256=
VITE_CODEX_COMMAND_CENTER_DOWNLOAD_VERSION=

# =============================================================================
# Server-side secrets (NOT prefixed VITE_ — never shipped to the client).
# Set these on the Supabase project via `supabase secrets set` so the
# stripe-webhook edge function can read them. They are listed here as
# documentation only; do NOT commit real values.
# =============================================================================

# Stripe — server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dedicated $20/month VibeSpace Access product. This is separate from the
# optional feature-plan prices below and must never map to profiles.tier.
STRIPE_APP_ACCESS_PRICE_ID=
# Optional comma-separated allowlist containing the current Access price plus
# any still-active rotated Access prices accepted by webhook reconciliation.
STRIPE_APP_ACCESS_PRICE_IDS=
# Server-side Access webhook grace window. The committed policy default is 3.
APP_ACCESS_GRACE_DAYS=3
# Stripe Price IDs that map to tiers in profiles.tier
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_APEX=
# Optional telemetry reward. The Stripe Coupon must be exactly 10% off,
# duration=forever. The policy version must match the currently published
# financial-incentive notice; the HTTPS notice URL is returned to the UI.
STRIPE_TELEMETRY_REWARD_COUPON_ID=
TELEMETRY_REWARD_POLICY_VERSION=
TELEMETRY_FINANCIAL_INCENTIVE_NOTICE_URL=

# Exact SemVer used by server-authoritative Access checks. Keep this in sync with
# VITE_APP_VERSION and the signed desktop release. Set it as a Supabase secret.
APP_VERSION=1.5.0

# Offline Access lease signer — server only. ACCESS_LEASE_SIGNING_JWK must be
# a private P-256 JWK; only its public counterpart belongs in
# VITE_ACCESS_LEASE_PUBLIC_KEYS above.
ACCESS_LEASE_KEY_ID=
ACCESS_LEASE_SIGNING_JWK=

# Supabase service role key — used by the edge function to update
# profiles.tier without RLS impersonation. Keep this OFF the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice / Calling / Messaging server secrets (Supabase secrets) ---
# Set via `npx supabase secrets set NAME="value"`. Never commit real values.
# These power the metered cloud TTS, message, and calling Edge Functions.
#
# Price ID aliases (the functions accept either STRIPE_*_PRICE_ID or the
# STRIPE_PRICE_* names above):
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=
STRIPE_APEX_PRICE_ID=
#
# Cloud TTS + message AI providers (company-paid; server only):
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
#
# Twilio (calling + SMS; server only — the desktop app NEVER holds these):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
#
# App base URL used for Stripe redirects + Twilio webhook URLs:
APP_BASE_URL=
#
# Kokoro local model manifest (public JSON; no secret):
MODEL_MANIFEST_URL=
GITHUB_MODEL_RELEASE_URL=
