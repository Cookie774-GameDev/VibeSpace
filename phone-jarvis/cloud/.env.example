# Provider keys — fill these in for local dev. Production uses Fly secrets.

# Supabase (operator-side; baked into Jarvis app build, but cloud also reads these)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
MCP_PUBLIC_URL=https://your-cloud-host.example/mcp

# Twilio (Path A)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# Telnyx (owner-approved Call Anyone transport)
TELNYX_API_KEY=<telnyx-api-key>
TELNYX_PUBLIC_KEY=<telnyx-ed25519-public-key>
TELNYX_CALL_CONTROL_CONNECTION_ID=<telnyx-call-control-connection-id>
TELNYX_PHONE_NUMBER=+15551234567

# LiveKit (Path C — get from livekit.io free tier or self-host)
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=secret_xxx
LIVEKIT_URL=wss://your-project.livekit.cloud

# Premium providers (Path A default stack)
DEEPGRAM_API_KEY=...
DEEPGRAM_FLUX_MODEL=flux-general-en
DEEPGRAM_AURA_MODEL=aura-2-thalia-en
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=<anthropic-api-key>
CARTESIA_API_KEY=...

# Free providers (Path C default stack — also fallback for Path A if user BYOK is missing)
GROQ_API_KEY=<groq-api-key>

# Bridge auth — generate via: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_TOKEN_PEPPER=replace_me_with_random_64_char_hex

# Audit log retention (days)
AUDIT_RETENTION_DAYS=30

# Cost cap per call (USD; AI hangs up if exceeded)
COST_CAP_PER_CALL=5.00

# Idle hangup (seconds of user silence before "you still there?")
IDLE_HANGUP_SECONDS=120

# Provider pricing used to convert measured usage into the unified credit pool.
# Set these from the provider's current contract; zero is fail-safe for estimates
# but must not be used for a production billing launch.
TELNYX_VOICE_USD_PER_MINUTE=0
DEEPGRAM_FLUX_USD_PER_MINUTE=0
DEEPGRAM_AURA_USD_PER_MILLION_CHARS=0
DEEPSEEK_INPUT_USD_PER_MILLION_TOKENS=0
DEEPSEEK_OUTPUT_USD_PER_MILLION_TOKENS=0

# Conservative all-provider reservation ceiling (credits/minute).
# 1 credit = $0.001; configure from current maximum contracted rates.
CALL_ANYONE_MAX_CREDITS_PER_MINUTE=96
