{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-mini-panel",
  "description": "Least-privilege capability for the Pixel Pet mini-panel. Window controls + core events for shared chat/terminal presentation. No shell open, no unrestricted filesystem.",
  "windows": ["pet-mini-panel"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-is-minimized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-close",
    "core:app:default",
    "core:path:default",
    "os:default",
    "dialog:default"
  ]
}
