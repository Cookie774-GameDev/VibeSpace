{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Jarvis main window. Grants the core IPC surface plus notification/dialog/os defaults and shell:open for external URLs. The http plugin scope explicitly allows the Ollama daemon and the major BYOK provider hosts so the native HTTP client can serve as a CORS-free fallback when the WebView blocks direct fetches in packaged builds.",
  "windows": ["main", "dictation", "pet-overlay", "pet-mini-panel", "preview-surface"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:app:default",
    "core:path:default",
    "notification:default",
    "dialog:default",
    "shell:allow-open",
    "os:default",
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:11434/*" },
        { "url": "http://127.0.0.1:11434/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "https://api.groq.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://api.deepseek.com/*" },
        { "url": "https://api.mistral.ai/*" },
        { "url": "https://api.together.xyz/*" },
        { "url": "https://api.x.ai/*" },
        { "url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/*" },
        { "url": "https://coding-intl.dashscope.aliyuncs.com/*" },
        { "url": "https://dashscope-us.aliyuncs.com/*" },
        { "url": "https://dashscope.aliyuncs.com/*" },
        { "url": "https://dashscope-intl.aliyuncs.com/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://api.figma.com/*" },
        { "url": "https://*.supabase.co/*" },
        { "url": "https://*.myshopify.com/*" },
        { "url": "https://slack.com/*" },
        { "url": "https://api.wulong.dev/*" },
        { "url": "https://lmarena.ai/*" },
        { "url": "https://arena.ai/*" }
      ]
    }
  ]
}
